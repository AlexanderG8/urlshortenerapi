{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ShortLinks": {
    "BaseUrl": "https://localhost:7260",
    "CodeLength": 7,
    "MaxAliasLength": 30,
    "MaxUrlLength": 2048,
    "ReservedAliases": [ "api", "scalar", "openapi", "health", "login", "register", "refresh", "admin", "stats" ],
    "BlockedDomains": [ "bit.ly", "tinyurl.com", "t.co" ]
  },
  "ClickTracking": {
    "ChannelCapacity": 10000,
    "BatchSize": 100,
    "FlushIntervalSeconds": 5
  }
}